# Sentinel Runtime LLM Configuration (Groq API only)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.0


# Sentinel Runtime Configuration
SENTINEL_ENV=development
LOG_LEVEL=INFO
INCIDENTS_DIR=incidents

# Sentinel Persistence Configuration
SENTINEL_PERSISTENCE_BACKEND=filesystem
SENTINEL_PERSISTENCE_ROOT=.sentinel_persistence
SENTINEL_DATABASE_URL=postgresql://sentinel:sentinel_dev_password@localhost:5432/sentinel_db

# Sentinel API-Key Authentication (Mission 20) — DISABLED by default.
# When enabled, every method other than GET/HEAD/OPTIONS requires the header
#   Authorization: Bearer <SENTINEL_API_KEY>
# SENTINEL_API_KEY must be non-empty or the server refuses to start.
SENTINEL_API_AUTH_ENABLED=false
SENTINEL_API_KEY=
# Optional: also protect GET/HEAD/OPTIONS (the /health route always stays public).
SENTINEL_API_AUTH_PROTECT_READS=false
