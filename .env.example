# Sentinel environment configuration (example).
#
# Copy to `.env` and adjust. The launchers call `load_dotenv()` before reading
# any environment variable, so values here apply automatically; variables already
# set in the shell take precedence. Every variable below is genuinely read by the
# running code — verify names against the source before adding more.

# ─── LLM (Groq) ─────────────────────────────────────────────────────────────
# Required when an investigation is submitted; unused otherwise.
GROQ_API_KEY=your_groq_api_key_here
# Model override (default: openai/gpt-oss-120b).
GROQ_MODEL=openai/gpt-oss-120b

# ─── Runtime ────────────────────────────────────────────────────────────────
# Application log level for both the API and the event worker:
# DEBUG, INFO, WARNING, ERROR or CRITICAL (case-insensitive).
# Absent, empty or unrecognised values fall back to INFO. Third-party library
# loggers are not affected.
LOG_LEVEL=INFO
# Directory holding the incident bundles, read by the API launcher.
# The --incidents-root CLI flag takes precedence. Defaults to 'incidents',
# which matches the Compose volume mounted at /app/incidents.
INCIDENTS_DIR=incidents

# ─── Persistence ────────────────────────────────────────────────────────────
# 'filesystem' (default) or 'postgres'.
SENTINEL_PERSISTENCE_BACKEND=filesystem
# Root directory for the filesystem backend.
SENTINEL_PERSISTENCE_ROOT=.sentinel_persistence
# PostgreSQL connection URL (required by the 'postgres' backend and the worker).
SENTINEL_DATABASE_URL=postgresql://sentinel:sentinel_dev_password@localhost:5432/sentinel_db

# ─── PostgreSQL connection pool (configures the 'postgres' backend) ─────────
# Pool sizing and the connection-acquisition timeout, shared by the API and the
# event worker through one configuration source. Values must be numeric; invalid
# or inconsistent values (min_size > max_size, non-positive timeouts) cause a
# clear, sanitised startup error rather than an invalid pool. No connection
# string or credential is ever included in those errors.
SENTINEL_PG_POOL_MIN_SIZE=1
SENTINEL_PG_POOL_MAX_SIZE=10
SENTINEL_PG_POOL_TIMEOUT_SECONDS=30.0

# ─── Transient PostgreSQL failure retry (SENTINEL_PG_RETRY_*) ───────────────
# Bounded retry of the whole save() transaction on transient contention errors
# (SQLSTATE 40001/40P01) with exponential backoff plus full jitter. Out-of-range
# or malformed values are clamped to valid bounds (they never crash startup).
SENTINEL_PG_RETRY_MAX_ATTEMPTS=5
SENTINEL_PG_RETRY_BASE_DELAY=0.05
SENTINEL_PG_RETRY_MAX_DELAY=1.0

# ─── Incident ingestion (opt-in) ────────────────────────────────────────────
# DISABLED by default. Any value other than 1/true/yes/on leaves POST /incidents
# disabled. Enabling it is NOT authentication — see the auth section below.
SENTINEL_ALLOW_INCIDENT_INGESTION=false
# Resource limits for one submitted bundle (counted in UTF-8 bytes).
SENTINEL_INGEST_MAX_FILES=200
SENTINEL_INGEST_MAX_FILE_BYTES=2097152
SENTINEL_INGEST_MAX_TOTAL_BYTES=20971520
SENTINEL_INGEST_MAX_REQUEST_BYTES=25165824

# ─── API-key authentication (opt-in) ────────────────────────────────────────
# DISABLED by default. When enabled, every method other than GET/HEAD/OPTIONS
# requires the header
#   Authorization: Bearer <SENTINEL_API_KEY>
# SENTINEL_API_KEY must be non-empty or the server refuses to start.
SENTINEL_API_AUTH_ENABLED=false
SENTINEL_API_KEY=
# Optional: also protect GET/HEAD/OPTIONS (the /health and /ready routes stay
# public for safe methods only; a non-safe method on either path is still
# protected).
SENTINEL_API_AUTH_PROTECT_READS=false

# ─── Readiness probe ────────────────────────────────────────────────────────
# HTTP response deadline (seconds) for the public GET /ready dependency check.
# Defaults to 2.0 when absent or invalid (empty, non-numeric, non-finite, zero or
# negative); valid positive values are capped at 30.0. This bound applies to the
# HTTP response only, not to the lifetime of a blocked filesystem or PostgreSQL
# operation: such work is not strictly cancellable and can outlive the deadline,
# but it remains constrained by the readiness admission capacity.
SENTINEL_READINESS_TIMEOUT_SECONDS=2.0
