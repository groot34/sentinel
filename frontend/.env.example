# Sentinel frontend environment (example).
#
# Copy to `.env.local` and adjust. Only variables prefixed with VITE_ are
# exposed to the browser bundle, so nothing secret may be placed here.

# Base URL used by the browser when talking to the Sentinel API.
# Leave empty (the default) to use same-origin requests, which the Vite dev
# server proxies to the backend. Set it to a full URL only when the frontend is
# served from a different origin than the API — in that case the backend must
# be configured to allow CORS.
VITE_SENTINEL_API_BASE_URL=
