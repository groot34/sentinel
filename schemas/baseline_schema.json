{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BaselineDiagnosis",
  "type": "object",
  "required": [
    "incident_id",
    "root_cause_guess",
    "reasoning",
    "confidence"
  ],
  "properties": {
    "incident_id": {
      "type": "string",
      "description": "Identifier of the analyzed incident bundle."
    },
    "root_cause_guess": {
      "type": "string",
      "description": "Single-call best guess explanation of the root cause."
    },
    "reasoning": {
      "type": "string",
      "description": "Unverified reasoning behind the diagnosis."
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Subjective confidence score reported by LLM."
    },
    "suggested_mitigation": {
      "type": "string",
      "description": "Optional general mitigation recommendation."
    }
  },
  "additionalProperties": false
}
