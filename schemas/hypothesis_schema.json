{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HypothesisEngineOutput",
  "type": "object",
  "required": ["incident_id", "hypotheses"],
  "properties": {
    "incident_id": {
      "type": "string",
      "description": "Identifier of the incident under investigation."
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "hypothesis_id",
          "claim",
          "evidence_ids",
          "supporting_reasoning",
          "falsification_criteria",
          "verification_plan"
        ],
        "properties": {
          "hypothesis_id": {
            "type": "string",
            "pattern": "^HYP-[0-9]{3}$",
            "description": "Unique hypothesis identifier, e.g. HYP-001."
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "description": "Specific, falsifiable statement of a candidate root cause."
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string"},
            "description": "Evidence IDs that directly support this claim."
          },
          "supporting_reasoning": {
            "type": "string",
            "minLength": 1,
            "description": "Narrative explanation linking the cited evidence to the claim."
          },
          "falsification_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"},
            "description": "Concrete conditions that, if observed, would disprove the hypothesis."
          },
          "verification_plan": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"},
            "description": "Ordered list of concrete verification steps to test the hypothesis."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
